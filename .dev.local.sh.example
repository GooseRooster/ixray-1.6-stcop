#!/usr/bin/env bash
# Personal dev hook — copy to ./.dev.local.sh (gitignored) to opt in.
#
# The flake's shellHook sources ./.dev.local.sh at the end of shell setup, so
# anything you export or run here happens after the toolchain, libraries, and
# nvim-relevant tools are already in place.
#
# This file is only a template — the real ./.dev.local.sh is entirely yours.
# Teammates without one see nothing (the source is guarded).

# ─── Personal env vars ─────────────────────────────────────────────────────
#
# Example: point CMake at extra prefixes, or toggle build options without
# editing the CMakeLists:
#
# export CMAKE_GENERATOR="Ninja"

# ─── Running the built binaries ────────────────────────────────────────────
#
# NuGet ships some dependencies as prebuilt glibc .so files under
# build/packages/*/runtimes/linux-x64/native/ (GameNetworkingSockets +
# libssl/libprotobuf, LuaJIT, mimalloc). They link fine at build time, but
# when *running* the engine you may need them on the loader path. On NixOS
# enable `programs.nix-ld.enable = true;` in your system config, and/or set:
#
# export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$PWD/build/packages/IXRay.Packages.LuaJIT.Runtimes.linux-x64.2023.8.23.1-open/runtimes/linux-x64/native"

# ─── Personal aliases / functions ──────────────────────────────────────────
#
# The two build flows (see flake.nix header for the full story):
#
# Native Linux — tools + engine core libs only. D3D renderers
# (R1/R2) must stay off; the playable engine is not buildable natively yet:
#   alias configure='cmake -B build -G Ninja -DIXRAY_USE_R1=OFF -DIXRAY_USE_R2=OFF'
#   alias build-compressor='cmake --build build --target xrCore xrSound xrNetServer xrCompress'
#
# Windows x64 cross-compile (winCross shell — the full playable game):
#   alias configure-win='cmake -B build-win -G "Ninja Multi-Config" -DCMAKE_TOOLCHAIN_FILE=cmake/msvc-cross.cmake'
#   alias build-engine='cmake --build build-win --config Release --target xrEngine'
#   # Output: build-win/bin/Release/ — copy its contents over the game's bin/
#   # directory for testing via Proton.
